<form class="pbta-choice-dialog">
    <div>{{desc}}</div>
    {{#if max}}
    <p class="choice-limit">{{localize "PBTA.ChoiceLimit" max=max}}</p>
    {{/if}}
    <ol class="items-list">
        {{#each choices}}
        <li class="item flexrow">
            <div class="item-name flexrow">
                <img src="{{this.img}}" height="32" width="32">
                <label>{{this.name}}</label>
            </div>
            {{#if this.disabled}}
			<input type="checkbox" data-locked="true" disabled>
            {{else}}
			<input type="checkbox" name="choice-{{this.index}}">
            {{/if}}
            <div class="item-description">
                {{{pbtaTags this.tags}}}
                <div class="description">{{editor this.desc editable=false engine="prosemirror"}}</div>
            </div>
        </li>
        {{/each}}
    </ol>
</form>
